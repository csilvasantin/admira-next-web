    {
      "id": "voz",
      "n": 1,
      "title": {
        "es": "Crear locución",
        "en": "Create a voiceover"
      },
      "url": "https://www.admira.studio/audio.html",
      "mode": "muestra",
      "steps": [
        {
          "op": "fill",
          "text": {
            "es": "Prepararemos el mensaje de bienvenida de la cafetería.",
            "en": "We will prepare the coffee shop welcome message."
          },
          "path": "/audio",
          "selector": "#proj-cliente",
          "value": "Alsea · Starbucks · demostración"
        },
        {
          "op": "fill",
          "text": {
            "es": "Definimos la identidad de la voz.",
            "en": "We define the voice identity."
          },
          "path": "/audio",
          "selector": "#a-personaje",
          "value": "Voz adulta cálida y cercana"
        },
        {
          "op": "select",
          "text": {
            "es": "Elegimos el idioma de la locución.",
            "en": "We choose the voiceover language."
          },
          "path": "/audio",
          "selector": "#a-idioma",
          "value": "Espanol (ES)"
        },
        {
          "op": "select",
          "text": {
            "es": "Elegimos un tono cercano al cliente.",
            "en": "We choose a warm tone."
          },
          "path": "/audio",
          "selector": "#a-tono",
          "value": "Cercano"
        },
        {
          "op": "fill",
          "text": {
            "es": "Escribimos el texto que escucharía el cliente en tienda.",
            "en": "We write the message the customer would hear in store."
          },
          "path": "/audio",
          "selector": "#a-guion",
          "value": "Bienvenidos a nuestra cafetería. Haz una pausa y disfruta de un café recién hecho."
        },
        {
          "op": "point",
          "text": {
            "es": "Este botón genera una locución nueva. En este recorrido escuchamos una ya preparada.",
            "en": "This button generates a new voiceover. Here we play a prepared one."
          },
          "path": "/audio",
          "selector": "#playOutput"
        },
        {
          "op": "video",
          "text": {
            "es": "Veamos el resultado preparado de esta función.",
            "en": "Let us see the prepared result of this feature."
          },
          "path": "/audio",
          "url": "https://www.admiranext.com/assets/demos/suite-v1/studio-voz.mp4"
        }
      ],
      "aliases": [
        "locucion",
        "voz"
      ]
    },
    {
      "id": "musica",
      "n": 2,
      "title": {
        "es": "Crear música",
        "en": "Create music"
      },
      "url": "https://www.admira.studio/musica.html",
      "mode": "muestra",
      "steps": [
        {
          "op": "select",
          "text": {
            "es": "Para el ambiente de tienda elegimos un loop instrumental.",
            "en": "For the store atmosphere we choose an instrumental loop."
          },
          "path": "/musica",
          "selector": "#m-versiones",
          "value": "Loop instrumental ~15s"
        },
        {
          "op": "select",
          "text": {
            "es": "Escogemos el estilo musical.",
            "en": "We choose the musical style."
          },
          "path": "/musica",
          "selector": "#m-style",
          "value": "blues"
        },
        {
          "op": "fill",
          "text": {
            "es": "Damos nombre a la pieza.",
            "en": "We name the piece."
          },
          "path": "/musica",
          "selector": "#m-titulo",
          "value": "Una pausa con café"
        },
        {
          "op": "fill",
          "text": {
            "es": "Describimos instrumentos y ambiente, sin letra cantada.",
            "en": "We describe the instruments and atmosphere, without sung lyrics."
          },
          "path": "/musica",
          "selector": "#m-letra",
          "value": "[Instrumental]\nPiano cálido, guitarra suave y contrabajo. Sin voz."
        },
        {
          "op": "point",
          "text": {
            "es": "Aquí se solicita la música. Escuchemos la muestra preparada.",
            "en": "Music is requested here. Let us hear the prepared sample."
          },
          "path": "/musica",
          "selector": "#playOutput"
        },
        {
          "op": "video",
          "text": {
            "es": "Veamos el resultado preparado de esta función.",
            "en": "Let us see the prepared result of this feature."
          },
          "path": "/musica",
          "url": "https://www.admiranext.com/assets/demos/suite-v1/studio-musica.mp4"
        }
      ],
      "aliases": [
        "musica"
      ]
    },
