      "mode": "recorrido",
      "steps": [
        {
          "op": "open",
          "text": {
            "es": "Abrimos las opciones de gestión del local.",
            "en": "We open the store management options."
          },
          "selector": "#pfOptions"
        },
        {
          "op": "open",
          "text": {
            "es": "Abrimos la gestión de locuciones.",
            "en": "We open voiceover management."
          },
          "selector": "[data-option-id=\"megafonia\"]"
        },
        {
          "op": "select",
          "text": {
            "es": "La voz local permite ensayar el mensaje.",
            "en": "A local voice allows us to rehearse the message."
          },
          "selector": "#announcementVoice",
          "value": "browser"
        },
        {
          "op": "fill",
          "text": {
            "es": "Preparamos el aviso que escucharía el cliente.",
            "en": "We prepare the message the customer would hear."
          },
          "selector": "#announcementText",
          "value": "Bienvenidos a Starbucks. Haz una pausa y disfruta de tu café."
        },
        {
          "op": "point",
          "text": {
            "es": "Este control emitiría el aviso. Ahora mostramos el ejemplo preparado.",
            "en": "This control would broadcast the message. We now show the prepared example."
          },
          "selector": "[data-xp-do=\"mega\"]"
        },
        {
          "op": "video",
          "text": {
            "es": "Veamos el resultado preparado de esta función.",
            "en": "Let us see the prepared result of this feature."
          },
          "url": "https://www.admiranext.com/assets/demos/suite-v1/store-voz.mp4"
        }
      ],
