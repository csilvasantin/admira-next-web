# Cloudflare Pages — cabeceras. El STATUS nunca se cachea (adiós al baile de versiones viejas).
/status
  Cache-Control: no-store, must-revalidate
/status.html
  Cache-Control: no-store, must-revalidate
/status/*
  Cache-Control: no-store, must-revalidate
# El resto revalida siempre (sirve fresco tras cada deploy, sin caché pegajosa).
/*
  Cache-Control: public, max-age=0, must-revalidate
# Marca blanca: cualquier web de la Galaxia (admira.studio, admira.store, admira.app,
# yokup.com y los dominios de cliente) carga los tokens, logos y fuentes desde aquí.
/marcablanca/*
  Access-Control-Allow-Origin: *
# Propuesta automática (FLT-101369): página privada, fuera de buscadores.
/marcablanca/propuesta/*
  X-Robots-Tag: noindex, nofollow

/assets/live-presence.js
  Access-Control-Allow-Origin: *
  Cache-Control: no-store

# Avatar digital (encargo avatar · 4-oct-2026): el cargador y el interruptor los
# leen todos los sitios de la red. Sin cookies ni datos personales.
/assets/avatar.js
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300

# Catálogo de sectores del avatar (6-oct-2026): lo lee brain.digitalavatar.ai y cualquier cara.
/avatar/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300

# Sello de versión con novedades (06-10-2026): cargador común de toda la suite; cada sitio
# lo pide con su ?v= y lee SU propio /version.json. Sin cookies ni datos personales.
/assets/sello-novedades.js
  Access-Control-Allow-Origin: *
  Cache-Control: no-store

# ⌘ EXPERTO · CLI compartido (look digitalavatar.ai): lo cargan studio, store, app, tv y biz.
/suite/*
  Access-Control-Allow-Origin: *
  Cache-Control: no-store

/demo
  Cache-Control: no-store
/demo/
  Cache-Control: no-store
/demo/*
  Cache-Control: no-store
/subdemos/
  Cache-Control: no-store
/subdemos/*
  Cache-Control: no-store
/subdemos/*.json
  Access-Control-Allow-Origin: *
/api/demo
  Cache-Control: no-store
